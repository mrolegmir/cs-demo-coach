# Optional local Compose worker configuration. Rules need no external service.
CSDC_LLM=rules
CSDC_WORKER_TOKEN=dev-worker-token

# For Ollama on the Docker host:
# CSDC_LLM=ollama
# CSDC_LLM_MODEL=your-installed-model
# CSDC_LLM_BASE_URL=http://host.docker.internal:11434

# For an OpenAI-compatible API, set its full API base explicitly:
# CSDC_LLM=openai
# CSDC_LLM_MODEL=your-model
# CSDC_LLM_BASE_URL=https://api.example.com/v1
# CSDC_LLM_API_KEY=replace-with-your-key
